# Website enquiry emails: the Contact Us and Scheduling forms send each request to MAIL_TO.
# Copy this file to .env.local and fill in SMTP_PASS (never commit .env.local).
# On Vercel, add the same keys under Project Settings > Environment Variables.

# The domain's email is hosted by GoDaddy (MX: secureserver.net). Outgoing server:
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true

# The mailbox that sends the emails, and its password
SMTP_USER=info@radiant-smiles.com
SMTP_PASS=

# Optional: the sender name/address and the inbox that receives the requests
MAIL_FROM="Radiant Smiles Website <info@radiant-smiles.com>"
MAIL_TO=info@radiant-smiles.com
